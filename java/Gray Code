class Solution {
    public List<Integer> grayCode(int n) {
        List<Integer> result = new ArrayList<>();
        // Total numbers in the sequence is 2^n
        int totalNumbers = 1 << n; 
        
        for (int i = 0; i < totalNumbers; i++) {
            // Formula: Gray(i) = i ^ (i >> 1)
            result.add(i ^ (i >> 1));
        }
        
        return result;
    }
}
