import java.util.HashMap;
import java.util.Map;

class Solution {
    int postorderIndex;
    Map<Integer, Integer> inorderMap;

    public TreeNode buildTree(int[] inorder, int[] postorder) {
        // Start from the last element of postorder
        postorderIndex = postorder.length - 1;
        inorderMap = new HashMap<>();
        
        for (int i = 0; i < inorder.length; i++) {
            inorderMap.put(inorder[i], i);
        }

        return arrayToTree(postorder, 0, inorder.length - 1);
    }

    private TreeNode arrayToTree(int[] postorder, int left, int right) {
        if (left > right) return null;

        // Current root is the element at postorderIndex
        int rootValue = postorder[postorderIndex--];
        TreeNode root = new TreeNode(rootValue);

        // Crucial: Build the RIGHT subtree before the LEFT subtree
        int splitIndex = inorderMap.get(rootValue);
        root.right = arrayToTree(postorder, splitIndex + 1, right);
        root.left = arrayToTree(postorder, left, splitIndex - 1);

        return root;
    }
}
