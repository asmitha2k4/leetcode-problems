class Solution {
    int maxGlobal = Integer.MIN_VALUE;

    public int maxPathSum(TreeNode root) {
        calculateSum(root);
        return maxGlobal;
    }

    private int calculateSum(TreeNode node) {
        if (node == null) return 0;

        // 1. Calcular el máximo de cada subárbol. 
        // Si el valor es negativo, lo ignoramos (usamos Math.max con 0).
        int left = Math.max(0, calculateSum(node.left));
        int right = Math.max(0, calculateSum(node.right));

        // 2. Calcular el camino máximo que pasa por este nodo como "pico" (izq + nodo + der)
        int currentPathSum = node.val + left + right;

        // 3. Actualizar nuestra respuesta global si este camino es el mejor encontrado
        maxGlobal = Math.max(maxGlobal, currentPathSum);

        // 4. Retornar al padre la mejor rama única (nodo + el mejor de sus hijos)
        return node.val + Math.max(left, right);
    }
}
