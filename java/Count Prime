class Solution {
    public int countPrimes(int n) {
        // Condition: strictly less than n
        if (n <= 2) {
            return 0;
        }
        
        // true = prime, false = not prime
        boolean[] isPrime = new boolean[n];
        // Initially mark all as true from index 2 onwards
        for (int i = 2; i < n; i++) {
            isPrime[i] = true;
        }
        
        // Sieve of Eratosthenes Logic
        for (int i = 2; i * i < n; i++) {
            if (isPrime[i]) {
                // Mark all multiples of i starting from i * i as false
                for (int j = i * i; j < n; j += i) {
                    isPrime[j] = false;
                }
            }
        }
        
        // Count remaining true values in the boolean array
        int count = 0;
        for (int i = 2; i < n; i++) {
            if (isPrime[i]) {
                count++;
            }
        }
        
        return count;
    }
}
