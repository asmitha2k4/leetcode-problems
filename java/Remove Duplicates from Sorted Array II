class Solution {
    public int removeDuplicates(int[] nums) {
        // If the array has 2 or fewer elements, it already meets the criteria
        if (nums.length <= 2) return nums.length;

        // k tracks the position for the next valid element
        int k = 2; 

        // Start iterating from the third element (index 2)
        for (int i = 2; i < nums.length; i++) {
            // If current element is different from the element 2 positions back,
            // it's allowed (either a new number or the 2nd occurrence).
            if (nums[i] != nums[k - 2]) {
                nums[k] = nums[i];
                k++;
            }
        }
        return k;
    }
}
