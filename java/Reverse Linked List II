class Solution {
    public ListNode reverseBetween(ListNode head, int left, int right) {
        if (head == null || left == right) return head;

        // Dummy node handles the case where left = 1 (reversing from the head)
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        ListNode prev = dummy;

        // 1. Reach the node just before the 'left' position
        for (int i = 0; i < left - 1; i++) {
            prev = prev.next;
        }

        // 'start' will be the first node of the reversed section
        // 'then' will be the node to be moved
        ListNode start = prev.next;
        ListNode then = start.next;

        // 2. Reverse the segment [left, right]
        // Example: 1 -> 2 -> 3 -> 4 -> 5, left=2, right=4
        for (int i = 0; i < right - left; i++) {
            start.next = then.next;
            then.next = prev.next;
            prev.next = then;
            then = start.next;
        }

        return dummy.next;
    }
}
