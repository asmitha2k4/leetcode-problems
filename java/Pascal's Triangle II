import java.util.*;

class Solution {
    public List<Integer> getRow(int rowIndex) {
        // Initialize the row with 1 at index 0
        List<Integer> row = new ArrayList<>();
        row.add(1);

        for (int i = 1; i <= rowIndex; i++) {
            // Add a 1 at the end for the new row
            row.add(1);
            
            // Update the middle elements from right to left
            // This prevents using an updated value for the next calculation
            for (int j = i - 1; j > 0; j--) {
                row.set(j, row.get(j) + row.get(j - 1));
            }
        }
        
        return row;
    }
}
